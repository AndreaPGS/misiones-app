<% content_for :title, "Nueva asignación" %>

<div class="admin-page-header">
  <div>
    <h1 class="admin-page-title">Nueva asignación</h1>
    <p class="admin-page-subtitle">Asignar manualmente una misión a un invitado</p>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card__body">

    <% if flash[:alert].present? %>
      <div class="error-summary" style="margin-bottom:var(--space-lg);">
        <p class="error-summary__title">⚠ <%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= form_with model: [:admin, @assignment], class: "admin-form" do |f| %>

      <div class="form-group">
        <%= f.label :guest_id, "Invitado", class: "form-label form-label--required" %>
        <%= f.select :guest_id,
              options_from_collection_for_select(
                @guests, :id, :name,
                params[:guest_id] || @assignment.guest_id
              ),
              { prompt: "Seleccionar invitado…" },
              class: "form-select" %>
      </div>

      <div class="form-group">
        <%= f.label :mission_id, "Misión", class: "form-label form-label--required" %>
        <%= f.select :mission_id,
              options_from_collection_for_select(
                @missions.select(&:active?), :id,
                ->(m) { "#{m.description.truncate(60)} (#{m.score} pts)" },
                @assignment.mission_id
              ),
              { prompt: "Seleccionar misión activa…" },
              class: "form-select" %>
        <p class="form-hint">Solo se muestran misiones activas. Se aplicarán las reglas de restricción.</p>
      </div>

      <div class="form-actions">
        <%= f.submit "Asignar misión", class: "admin-btn admin-btn--primary" %>
        <%= link_to "Cancelar", admin_mission_assignments_path, class: "admin-btn admin-btn--ghost" %>
      </div>

    <% end %>
  </div>
</div>

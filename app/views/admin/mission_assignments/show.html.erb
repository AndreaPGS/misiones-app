<% content_for :title, "Asignación" %>

<div class="admin-page-header">
  <div>
    <h1 class="admin-page-title">Detalle de asignación</h1>
    <p class="admin-page-subtitle">
      <span class="<%= status_chip_class(@assignment.status) %>">
        <%= status_label(@assignment.status) %>
      </span>
    </p>
  </div>
  <div style="display:flex; gap:var(--space-sm); flex-wrap:wrap;">
    <% if @assignment.assigned? %>
      <%= button_to "✅ Confirmar completada",
            complete_admin_mission_assignment_path(@assignment),
            method: :patch,
            class: "admin-btn admin-btn--complete",
            data: { turbo_confirm: "¿Confirmar misión completada? Se sumarán #{@assignment.mission.score} puntos a #{@assignment.guest.name}." } %>
    <% end %>
    <%= link_to "✏ Editar fechas", edit_admin_mission_assignment_path(@assignment),
          class: "admin-btn admin-btn--ghost" %>
    <%= button_to "🗑 Eliminar",
          admin_mission_assignment_path(@assignment),
          method: :delete,
          class: "admin-btn admin-btn--danger",
          data: { turbo_confirm: "¿Eliminar esta asignación?" } %>
  </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-lg); align-items:start;">

  <%# Guest card %>
  <div class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title">Invitado</h2></div>
    <div class="admin-card__body" style="display:flex; align-items:center; gap:var(--space-md);">
      <div class="avatar avatar--md">
        <% if @assignment.guest.picture.present? %>
          <img src="<%= @assignment.guest.picture %>" alt="<%= @assignment.guest.name %>">
        <% else %>
          <div class="avatar__initials">
            <%= @assignment.guest.name.split.map(&:first).first(2).join.upcase %>
          </div>
        <% end %>
      </div>
      <div>
        <p style="font-weight:700; font-size:1rem;"><%= @assignment.guest.name %></p>
        <p style="font-size:0.875rem; color:var(--text-soft);">
          ⭐ <%= @assignment.guest.points %> pts
        </p>
        <%= link_to "Ver perfil →", admin_guest_path(@assignment.guest),
              class: "admin-btn admin-btn--ghost admin-btn--sm",
              style: "margin-top:var(--space-sm);" %>
      </div>
    </div>
  </div>

  <%# Mission card %>
  <div class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title">Misión</h2></div>
    <div class="admin-card__body">
      <div class="mission-card" style="box-shadow:none; border:2px solid var(--muted);">
        <div class="mission-card__header">
          <span class="mission-card__icon">🎯</span>
          <span class="mission-card__score">★ <%= @assignment.mission.score %> pts</span>
        </div>
        <p class="mission-card__description"><%= @assignment.mission.description %></p>
      </div>
      <%= link_to "Ver misión →", admin_mission_path(@assignment.mission),
            class: "admin-btn admin-btn--ghost admin-btn--sm",
            style: "margin-top:var(--space-md);" %>
    </div>
  </div>

</div>

<%# Timestamps %>
<div class="admin-card mt-lg">
  <div class="admin-card__header"><h2 class="admin-card__title">Fechas</h2></div>
  <div class="admin-card__body">
    <div class="detail-grid">
      <div class="detail-row">
        <span class="detail-label">Asignada</span>
        <span class="detail-value">
          <%= @assignment.assigned_at&.strftime("%-d de %B %Y, %H:%M") || "—" %>
        </span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Completada</span>
        <span class="detail-value">
          <%= @assignment.completed_at&.strftime("%-d de %B %Y, %H:%M") || "—" %>
        </span>
      </div>
    </div>
  </div>
</div>

<div class="mt-lg">
  <%= link_to "← Volver a asignaciones", admin_mission_assignments_path,
        class: "admin-btn admin-btn--ghost" %>
</div>

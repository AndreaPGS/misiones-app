<div class="admin-list-item">
  <span style="font-size:1.25rem; flex-shrink:0;">🎯</span>

  <div class="admin-list-item__body">
    <p class="admin-list-item__title"><%= mission.description.truncate(70) %></p>
    <p class="admin-list-item__meta">
      Target: <strong><%= mission.target.name %></strong>
      &nbsp;·&nbsp;
      <span style="font-weight:700; color:#c49a00;">★ <%= mission.score %> pts</span>
      &nbsp;·&nbsp;
      <% if mission.active? %>
        <span class="status-chip status-chip--completed">Activa</span>
      <% else %>
        <span class="status-chip status-chip--abandoned">Inactiva</span>
      <% end %>
    </p>
  </div>

  <div class="admin-list-item__actions">
    <%= link_to "Ver", admin_mission_path(mission), class: "admin-btn admin-btn--ghost admin-btn--sm" %>
    <%= link_to "✏", edit_admin_mission_path(mission), class: "admin-btn admin-btn--primary admin-btn--sm" %>
    <%= button_to "🗑", admin_mission_path(mission),
          method: :delete,
          class: "admin-btn admin-btn--danger admin-btn--sm",
          data: { turbo_confirm: "¿Eliminar esta misión?" } %>
  </div>
</div>
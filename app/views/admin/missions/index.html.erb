<% content_for :title, "Misiones" %>

<div class="admin-page-header">
  <div>
    <h1 class="admin-page-title">Misiones</h1>
    <p class="admin-page-subtitle"><%= @missions.count %> en total</p>
  </div>
  <%= link_to "＋ Nueva misión", new_admin_mission_path, class: "admin-btn admin-btn--primary" %>
</div>

<nav class="filter-bar" aria-label="Agrupar misiones">
  <%= link_to "Sin agrupar", admin_missions_path, class: "admin-btn admin-btn--sm #{@grouping == 'none' ? 'admin-btn--dark' : 'admin-btn--ghost'}" %>
  <%= link_to "Por puntaje", admin_missions_path(group: "score"), class: "admin-btn admin-btn--sm #{@grouping == 'score' ? 'admin-btn--dark' : 'admin-btn--ghost'}" %>
  <%= link_to "Por invitado target", admin_missions_path(group: "target"), class: "admin-btn admin-btn--sm #{@grouping == 'target' ? 'admin-btn--dark' : 'admin-btn--ghost'}" %>
</nav>

<div class="admin-card">
  <% if @missions.any? %>
    <div class="admin-list">
      <% @mission_groups.each do |group_name, missions| %>
        <% if group_name.present? && @grouping == "score" %>
          <div class="admin-card__header mission-group-heading">
            <h2 class="admin-card__title">★ <%= group_name %> puntos</h2>
          </div>
        <% elsif group_name.present? && @grouping == "target" %>
          <div class="admin-card__header mission-group-heading">
            <h2 class="admin-card__title">🎯 <%= group_name %></h2>
          </div>
        <% end %>

        <% missions.each do |mission| %>
          <%= render "mission", mission: mission %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="admin-card__body" style="text-align:center; color:var(--text-soft); padding:var(--space-2xl);">
      <p style="font-size:2rem; margin-bottom:var(--space-md);">🎯</p>
      <p>Sin misiones todavía. <%= link_to "Crear la primera", new_admin_mission_path %></p>
    </div>
  <% end %>
</div>
